<Window x:Class="AI_for_Revit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AI_for_Revit"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="450" Width="800"
        ResizeMode="CanResizeWithGrip" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"

        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary Source="/Themes/Generic.xaml"/>
    </Window.Resources>

    <Grid>
        <Border Background="#666666" CornerRadius="6" BorderThickness="2" BorderBrush="#ff8000">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <!-- Верхняя панель -->
                    <RowDefinition Height="*"/>
                    <!-- Основное содержимое -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель -->
                <Border Background="#ff8000" Grid.Row="0" Height="40" CornerRadius="1,1,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="AI for Revit - Настройки" Foreground="White" 
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                            <!-- Кнопка свернуть -->
                            <Button Content="−" Click="MinimizeButton_Click" Width="30" Height="30"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Padding="0"
                            ToolTip="Свернуть окно"/>

                            <!-- Кнопка закрыть -->
                            <Button Content="✖" Click="CloseButton_Click" Width="30" Height="30"
                            Background="Transparent" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Padding="0"
                            ToolTip="Закрыть окно"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="API-ключ" Foreground="White" 
                    FontSize="16" FontWeight="Bold"
                    VerticalAlignment="Center" Margin="15, 0, 0, 0"/>
                    
                    <Border Grid.Row="2" CornerRadius="6" Background="#E5E5E5" BorderBrush="#A0A0A0" BorderThickness="1" Margin="15">
                        <TextBox Name="APIKeyTextBox" Height="50"
                        Style="{StaticResource RoundedTextBoxStyle}"
                        Text="" 
                        HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Text="API-провайдер" Foreground="White" 
                    FontSize="16" FontWeight="Bold"
                    VerticalAlignment="Center" Margin="15, 0, 0, 0"/>

                    <Border Grid.Row="2" CornerRadius="6" Background="#E5E5E5" BorderBrush="#A0A0A0" BorderThickness="1" Margin="15">
                        <TextBox Name="ProviderTextBox" Height="50"
                        Style="{StaticResource RoundedTextBoxStyle}"
                        
                        Text="" 
                        HorizontalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Text="Модель" Foreground="White" 
                    FontSize="16" FontWeight="Bold"
                    VerticalAlignment="Center" Margin="15, 0, 0, 0"/>

                    <Border Grid.Row="2" CornerRadius="6" Background="#E5E5E5" BorderBrush="#A0A0A0" BorderThickness="1" Margin="15">
                        <TextBox Name="ModelTextBox" Height="50"
                        Style="{StaticResource RoundedTextBoxStyle}"
                       
                        HorizontalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="2" FlowDirection="RightToLeft" Orientation="Horizontal">
                    <Button Content="Сохранить"  Style="{StaticResource RoundedButtonStyle}" x:Name="SendButton" Margin="15" />
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</Window>
